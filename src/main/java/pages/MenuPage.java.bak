package pages;

import org.openqa.selenium.By;
import com.vinayak.healing.core.HealingWebDriver;

public class MenuPage {
    private final HealingWebDriver driver;

    // The broken locator. 
    // The engine will extract "about link" and find <a id="about_sidebar_link">About</a>
    private final By aboutLink = By.id("broken-about-link-999");

    public MenuPage(HealingWebDriver driver) {
        this.driver = driver;
    }

    public void clickAboutLink() {
        System.out.println("Attempting to click the hidden 'About' link...");
        driver.findElement(aboutLink).click();
    }
}